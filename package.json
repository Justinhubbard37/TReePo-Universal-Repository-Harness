{
  "name": "treepo",
  "version": "0.1.0-dev",
  "description": "TReePo - Universal Repository Harness (v1 implementation)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "treepo": "dist/bin/treepo.js"
  },
  "files": [
    "dist/bin/",
    "dist/src/"
  ],
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "test:unit": "node --test \"test/unit/**/*.test.ts\"",
    "test:static": "node --test \"test/static/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "accept": "node test/acceptance/run.ts",
    "build": "node scripts/build.ts",
    "prepack": "node scripts/build.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "typescript": "6.0.3"
  }
}
